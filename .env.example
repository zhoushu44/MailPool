# ---------------------------------------------------------------------------
# 环境变量示例（复制为 .env 并填入真实值）
# ---------------------------------------------------------------------------

# 管理后台口令（必填；为空时仅允许 127.0.0.1 访问）
MAILPOOL_ADMIN_PASSWORD=

# 数据目录（容器内默认 /app/data）
MAILPOOL_DATA=/app/data

# 监听地址与端口
MAILPOOL_HOST=0.0.0.0
MAILPOOL_PORT=18080

# 会话签名密钥（不填则首次启动自动生成并持久化到 data/.session_secret）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
MAILPOOL_SESSION_SECRET=

# 时区
TZ=Asia/Shanghai